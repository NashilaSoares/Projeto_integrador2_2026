# Banco de dados
POSTGRES_USER=seacomp
POSTGRES_PASSWORD=mypass
POSTGRES_DB=seacomp_time
DATABASE_URL="postgresql://seacomp:mypass@localhost:5433/seacomp_time"

# API (apps/api)
NODE_ENV=development
API_PORT=3001
JWT_SECRET=change-this-to-a-random-string-of-at-least-32-chars
JWT_EXPIRES_IN=8h
CORS_ORIGIN=http://localhost:3000
RESEND_API_KEY=
EMAIL_FROM=

# Web (apps/web)
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
API_URL=http://api:3001/api/v1
NEXTAUTH_SECRET=change-this-to-a-random-string-of-at-least-32-chars
NEXTAUTH_URL=http://localhost:3000
WEB_URL=http://localhost:3000
